# === Core ===
ENVIRONMENT=development
APP_NAME=VA Schools — Marketing Intelligence
# Dev Vite (:5173 + proxy /api,/auth): FRONTEND_URL=http://localhost:5173
# Dev/prod SPA cùng cổng API (:8000): để trống hoặc FRONTEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# PostgreSQL / Redis (local dev: docker compose up -d db redis)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/vaschools_mkt
REDIS_URL=redis://localhost:6379/0

# Khoá ký session cookie. BẮT BUỘC đổi ở production.
# Sinh khoá: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-change-me

# === Google OAuth ===
# Redirect URI phải khai báo trong Google Cloud Console:
#   http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAINS=vaschools.edu.vn,hcm.vaschools.edu.vn

# === Providers ===
# Mặc định fake: quên cấu hình thì mất chức năng, không mất tiền.
# Xem docs/04-integrations/provider-abstraction.md
# fake | serpapi | dataforseo
SERP_PROVIDER=fake
SERP_API_KEY=
SERP_API_LOGIN=
SERP_API_PASSWORD=
SERP_DEFAULT_LOCATION=VN
SERP_DEFAULT_LANGUAGE=vi

# Google Ads API (Keyword Planner) — kiểm tra tuần 1
KEYWORD_PLANNER_PROVIDER=fake
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

BACKLINK_PROVIDER=fake
BACKLINK_API_KEY=

# === Trần chi phí — BẮT BUỘC đặt trước khi bật provider thật ===
MONTHLY_SERP_REQUEST_CAP=20000

# === Frontend (Vite) ===
# Rỗng = same-origin (khuyến nghị với Vite proxy). Hoặc http://localhost:8000
VITE_API_URL=
